{
  "version": 2,
  "buildCommand": "node ./scripts/vercel-build.mjs",
  "routes": [
    { "src": "/api(/.*)?", "dest": "/api/[...path].js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "api/[...path].js", "use": "@vercel/node" },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist/public" } }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}

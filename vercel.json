{
  "version": 2,
  "buildCommand": "npm run build && node_modules/.bin/esbuild api/index.ts --platform=node --bundle --format=esm --outfile=api/index.js --external:pg-native --external:bufferutil --external:utf-8-validate",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}

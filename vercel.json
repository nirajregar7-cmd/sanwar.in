{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "server/**,shared/**",
      "externalNodeModules": [
        "@google-cloud/storage",
        "google-gax",
        "ws",
        "pg",
        "pg-native",
        "bcrypt",
        "multer",
        "nodemailer",
        "web-push",
        "twilio",
        "qrcode"
      ]
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
